= render layout: 'layouts/header' do
  .navbar.navbar-expand-lg.bg-body-tertiary
    .container-fluid
      .navbar-brand.logo
        = t('layouts.logo').html_safe
        -if FoodsoftConfig[:display_demo_warning]
          %span.demo-mode
            %i.glyphicon.glyphicon-warning-sign
            = t ".demo_mode"
      %button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation")
        %span.navbar-toggler-icon
      #navbarSupportedContent.navbar-collapse.collapse.justify-content-between
        = render_navigation expand_all: true, renderer: :bootstrap5
        %ul.nav.navbar-nav
          %li.nav-item.dropdown
            %a.nav-link.dropdown-toggle(data-bs-toggle="dropdown" aria-expanded="false" href="#" role="button")
              = show_user current_user
            %ul.dropdown-menu
              %li= link_to t('.profile'), my_profile_path, class: 'dropdown-item'
              %li= link_to t('.ordergroup'), my_ordergroup_path, class: 'dropdown-item'
              - if BankAccount.any? && FinancialTransactionType.with_name_short.any?
                %li= link_to t('.reference_calculator'), home_reference_calculator_path, class: 'dropdown-item'
              %li= link_to t('.logout'), logout_path, class: 'dropdown-item'
          %li.nav-item{class: ('disabled' if FoodsoftConfig[:homepage].blank?)}
            = link_to FoodsoftConfig[:name], FoodsoftConfig[:homepage], class: 'nav-link', target: '_blank'
          - if FoodsoftConfig[:help_url]
            %li.nav-item= link_to t('.help'), FoodsoftConfig[:help_url], class: 'nav-link', target: '_blank'

  #main.container-fluid
    .row
      - if content_for?(:sidebar)
        .col-md-3
          = yield(:sidebar)
        .col-md-9
          = bootstrap_flash_patched
          - if content_for?(:actionbar)
            .btn-toolbar.pull-right= yield(:actionbar)
          - if show_title?
            .page-header
              %h1= yield(:title)
          = yield
      - else
        .col-md-12
          = bootstrap_flash_patched
          - if content_for?(:actionbar)
            .btn-toolbar.pull-right= yield(:actionbar)
          - if show_title?
            .page-header
              %h1= yield(:title)
          = yield

    = render 'layouts/footer'
  #modalContainer.modal.fade(tabindex="-1" role="dialog")
