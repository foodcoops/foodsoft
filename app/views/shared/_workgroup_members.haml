.card
  %h5.card-header= t '.title'
  #groupMembers.accordion.accordion-flush
    - Workgroup.all.each do |workgroup|
      .accordion-item
        .accordion-header
          %button.accordion-button.collapsed(type="button" data-bs-toggle="collapse" data-bs-target="#collapse#{workgroup.id}" aria-expanded="false" aria-controls="#collapse#{workgroup.id}")= workgroup.name
        %div{id: "collapse#{workgroup.id}", class: 'accordion-collapse collapse', "data-bs-parent": "#groupMembers"}
          .accordion-body
            %ul.list-unstyled
              - workgroup.users.includes(:groups).natural_order.each do |user|
                %li
                  = show_user(user)
                  %small (#{user.ordergroup.try(:name)})

