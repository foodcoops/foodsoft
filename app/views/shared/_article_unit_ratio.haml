- original_ratio = defined?(original_ratios) ? original_ratios&.to_a&.dig(article_unit_ratio_counter) : nil
- changed = !original_ratio.nil? && (original_ratio.quantity != article_unit_ratio.quantity || original_ratio.unit != article_unit_ratio.unit)
%tr{:class => 'no-indent-left', :colspan => '9', :style => changed ? "background-color: yellow" : ""}
  = f.fields_for(:article_unit_ratios, article_unit_ratio) do |sub_form|
    %td
      -# TODO: Check, if there was any justified reason for this article_unit_ratio_counter logic:
      -#= hidden_field f.object.class.to_s.underscore + "[article_unit_ratios_attributes][#{article_unit_ratio_counter + 1}]", :sort, value:
      = sub_form.input :sort, as: :hidden, wrapper: :inline_form
      %div.d-flex.align-items-center.gap-1.w-100.custom-form-fields-wrapper
        .input-group
          = sub_form.input_field :quantity, class: 'form-control'
          .input-group-text= '&times;'.html_safe
          = sub_form.input_field :unit, as: :select, collection: @article_units, include_blank: true, class: 'form-control', style: 'width:120px'
          .input-group-text
            = t('.per')
            .unit_multiplier.ms-2{:style => 'width: 80px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis'}
        .actions{style: 'width:1em, justify-self: end'}
          = link_to t('.remove'), method: :delete, 'data-remove-ratio' => true, title: t('.remove'), class: 'btn btn-danger btn-sm' do
            = fa_icon :remove