.row.mb-3
  %label.control-label.col-sm-4{for: 'article_version_price'}
    = ArticleVersion.human_attribute_name(:price)
  .col-sm-8.d-flex
    .input-group.unit-wrapper
      %span.input-group-text= t 'number.currency.format.unit'
      = f.input_field :price, class: 'form-control', step: 0.001, style: 'width: 150px;'
      .input-group-text.unit-suffix
        = t('articles.form.per')
        %span.unit-label-single.ms-1
      = f.select :price_unit, [], {include_blank: false}, {class: 'form-control', 'data-initial-value': article.price_unit}
%row
  = f.input :tax do
    .input-group
      = f.input_field :tax, class: 'form-control'
      %span.input-group-text %
  = f.input :deposit do
    .input-group
      %span.input-group-text= t 'number.currency.format.unit'
      = f.input_field :deposit, class: 'form-control'
.row.d-flex.align-items-center{ style: "padding-bottom:15px" }
  .col-sm-4.control-label{for: 'article_fc_price'}
    = Article.human_attribute_name(:fc_price)
  .col-sm-8.custom-form-fields-wrapper
    %div.input-group-text.gap-1#article_fc_price
      %span.price_value
      %span.price_per_text=t('articles.form.per')
      %span.price_unit
