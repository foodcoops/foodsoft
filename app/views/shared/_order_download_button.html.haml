.btn-group
  %button{type: "button", class: "btn btn-secondary #{klass} dropdown-toggle", 'data-bs-toggle' => 'dropdown', 'aria-expanded' => 'false'}
    = t '.title'
  %ul.dropdown-menu
    %li.dropdown-item= order_pdf(order, :groups, t('.group_pdf'))
    %li.dropdown-item= order_pdf(order, :articles, t('.article_pdf'))
    %li.dropdown-item= order_pdf(order, :matrix, t('.matrix_pdf'))
    %li.dropdown-item= order_pdf(order, :fax, t('.fax_pdf'))
    - unless order.stockit?
      %li.dropdown-item= link_to t('.fax_txt'), order_path(order, format: :txt), {title: t('.download_file')}
    %li.dropdown-item= link_to t('.fax_csv'), order_path(order, format: :csv), {title: t('.download_file')}
