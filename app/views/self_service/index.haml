= render 'shared/articles_by/common'
= render 'event_listeners'
= render partial: 'shared/js_templates/unit_conversion_popover_template', locals: {set_units_data: true}

- title t('.title')
#self-service
  = render 'funds'
  %ul.nav.nav-tabs
    %li.nav-item
      %a.nav-link.active#pickup-tab{:href => '#pickup', 'data-bs-toggle' => 'tab'}=t('.pickup')
    %li.nav-item
      %a.nav-link#transactions-tab{:href => '#transactions', 'data-bs-toggle' => 'tab'}=t('.transactions')
  %div.tab-content
    .mt-3#pickup.tab-pane.active
      = render 'pickup'
    .mt-3#transactions.tab-pane
      = render 'transactions'
