- title t('.title')

- content_for :javascript do
  :javascript
    var ordergroup = $($.parseHTML("#{escape_javascript(render('ordergroup'))}"));
    var ordergroups = #{raw @ordergroups.to_json};

    $(function() {
      $(document).on('touchclick', 'a[data-remove-transaction]', function() {
        $(this).parents('tr').remove();
        return false;
      });

      $(document).on('touchclick', 'a[data-add-transaction]', function() {
        ordergroup.clone().appendTo('#ordergroups');
        return false;
      });

      $(document).on('touchclick', 'a[data-add-all-ordergroups]', function() {
        var customField = $(this).data('custom-field');
        var value;
        if (!customField) {
          value = prompt("#{escape_javascript(heading_helper(FinancialTransaction, :amount))}:");
          if (value === null) {
            return false;
          }
        }
        $('#ordergroups > tbody > tr').remove();
        for (var id in ordergroups) {
          if (!ordergroups.hasOwnProperty(id)) {
            continue;
          }
          if (customField) {
            value = ordergroups[id][customField];
          }
          var row = ordergroup.clone();
          row.find('td > input').val(value);
          row.find('td > select').val(id);
          row.appendTo('#ordergroups');
        }
        return false;
      });
    });

- content_for :sidebar do
  .card.bg-light
    .card-body= t('.sidebar')

%div
  = form_tag finance_create_transaction_collection_path, class: 'd-flex flex-column gap-3' do
    - if FinancialTransactionType.has_multiple_types
      .row.col-md-7
        = label_tag :type_id, FinancialTransaction.human_attribute_name(:financial_transaction_type), class: 'form-label col-md-4'
        .col-md-8
          = select_tag :type_id, options_for_select(FinancialTransactionType.order(:name).map { |t| [ t.name, t.id ] }, params[:type_id]), class: 'form-select'
    .row.col-md-7
      = label_tag :note, FinancialTransaction.human_attribute_name(:note), class: 'form-label col-md-4'
      .col-md-8
        = text_area_tag :note, params[:note], class: 'form-control', rows: 4, required: 'required'
    .form-check
      = check_box_tag :set_balance, true, params[:set_balance], class: 'form-check-input'
      = label_tag :set_balance, t('.set_balance'), class: 'form-check-label'
    .col-md-8
      %table#ordergroups
        %thead
          %tr
            %th= heading_helper FinancialTransaction, :ordergroup
            %th= heading_helper FinancialTransaction, :amount
        %tbody
          = render :partial => 'ordergroup', :collection => [1, 2, 3]
    .d-flex.gap-1
      = link_to t('.new_ordergroup'), '#', 'data-add-transaction' => true, class: 'btn btn-secondary'
      = link_to t('.add_all_ordergroups'), '#', 'data-add-all-ordergroups' => true, class: 'btn btn-secondary'
    - if FoodsoftConfig[:use_financial_links]
      .form-check
        = check_box_tag :create_financial_link, true, params.fetch(:create_financial_link, true), class: 'form-check-input'
        = label_tag :create_financial_link, t('.create_financial_link'), class: 'form-check-label'
      .form-check
        = check_box_tag :create_foodcoop_transaction, true, params.fetch(:create_foodcoop_transaction, true), class: 'form-check-input'
        = label_tag :create_foodcoop_transaction, t('.create_foodcoop_transaction'), class: 'form-check-label'
    .col-md-7
      - Ordergroup.custom_fields.each do |f|
        - if f[:financial_transaction_source]
          = link_to t('.add_all_ordergroups_custom_field', label: f[:label]), '#', 'data-custom-field' => f[:name], 'data-add-all-ordergroups' => true, class: 'btn btn-secondary'
    %div
      = submit_tag t('.save'), class: 'btn btn-primary'
      = link_to t('ui.or_cancel'), finance_ordergroups_path
