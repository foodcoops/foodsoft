= simple_form_for :report, url: finance_report_path, method: :post, validate: true, html: { target: '_blank' } do |f|
  .modal-dialog
    .modal-content
      .modal-header
        = close_button :modal
        %h3.modal-title= t('.title')
      .modal-body
        = f.input :date_start, as: :date, html5: true
        = f.input :date_end, as: :date, html5: true
      .modal-footer
        = link_to t('ui.close'), '#', class: 'btn btn-default', data: { dismiss: 'modal' }
        = f.submit t('.submit'), class: 'btn btn-primary'
