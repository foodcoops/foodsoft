/ insert_after 'erb:contains("notify.input \'upcoming_tasks\'")'
- if FoodsoftMessages.enabled?
  = s.simple_fields_for :messages do |messages|
    = messages.input 'send_as_email', as: :boolean, inline_label: t('.send_as_email'), input_html: { checked: f.object.settings.messages['send_as_email'] }
  - if Messagegroup.any?
    %div
      = link_to messagegroups_path do
        = t '.messagegroups'
        %i.icon.icon-chevron-right
